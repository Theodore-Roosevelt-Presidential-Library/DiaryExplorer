   "medium": "ink",
   "hand": "TR",
   "lines": [
    "15 of us started in special",
    "car for Niagara; Robinson,",
    "Bells[?], Beekman, Whitmore, Emlen,",
    "Colgate, Weir[?] & myself; Alice,",
    "Corinne, Bamie, the Miss",
    "Parishes, Turnbull & Robinson.",
    "Greatest kind of fun."
   ],
   "rows": null,
   "columns": null,
   "confidence": "medium",
   "note": null
  },
  {
   "id": "b3",
   "date": "1881-01-15",
   "kind": "entry",
   "position": "body",
   "medium": "ink",
   "hand": "TR",
   "lines": [
    "Ideal day; perpetual spree.",
    "Saw falls, rapids, &",
    "whirlpool; took long",
    "sleighrides; ended up",
    "with every kind of",
    "dance in evening. Took",
    "hotel by storm. Every body",
    "so jolly & congenial."
   ],
   "rows": null,
   "columns": null,
   "confidence": "high",
   "note": "Last line at very bottom edge of page."
  }
