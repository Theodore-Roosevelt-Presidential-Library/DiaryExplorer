   "lines": [
    "Spent the morning",
    "in Hults[?] Woods;",
    "shot Parula americana",
    "& Coturniculus passerinus.",
    "Had a splendid",
    "ride on Lightfoot.",
    "Annie Murray has",
    "come to spend a",
    "few days with",
    "Conie.",
    "Aunt Annie",
    "& Uncle Jimmie",
    "are at Oyster Bay.",
    "O, Father, Father",
    "how bitterly I",
    "miss you, mourn you",
    "and long for you!"
   ],
   "rows": null,
   "columns": null,
   "confidence": "medium",
