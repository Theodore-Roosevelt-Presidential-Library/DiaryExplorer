   "lines": [
    "Rowed round Centre",
    "Island; high tide",
    "and dead calm,",
    "but hotter than",
    "Tophet. Started",
    "10.45; Pine Neck",
    "11.20; (portage takes",
    "5 minutes); Plum",
    "Point 11.50; returned",
    "12.13.",
    "Had a long",
    "gallop with",
    "Emlen beyond",
    "and around",
    "Wheatley"
   ],
